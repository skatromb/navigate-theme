{
  "name": "navigate-theme",
  "displayName": "Navigate",
  "description": "Color theme that helps you navigate through the code",
  "version": "0.10.0",
  "publisher": "skatromb",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skatromb/navigate-theme.git",
    "directory": "vscode"
  },
  "scripts": {
    "build": "node src/build.js",
    "vscode:prepublish": "npm run build",
    "package": "npx --yes @vscode/vsce package --baseImagesUrl https://github.com/skatromb/navigate-theme/raw/${GITHUB_REF_NAME:-HEAD}/ --baseContentUrl https://github.com/skatromb/navigate-theme/blob/${GITHUB_REF_NAME:-HEAD}/ -o navigate.vsix",
    "dev": "npm run package && code --install-extension navigate.vsix --force",
    "render": "node src/render.js rust ../samples/rust/dark.png && node src/render.js python ../samples/python/dark.png && node src/render.js sql ../samples/sql/dark.png && node src/render.js dbt ../samples/dbt/dark.png && node src/render.js json ../samples/json/dark.png && node src/render.js yaml ../samples/yaml/dark.png && node src/render.js toml ../samples/toml/dark.png && node src/render.js rust ../samples/rust/light.png light && node src/render.js python ../samples/python/light.png light && node src/render.js sql ../samples/sql/light.png light && node src/render.js dbt ../samples/dbt/light.png light && node src/render.js json ../samples/json/light.png light && node src/render.js yaml ../samples/yaml/light.png light && node src/render.js toml ../samples/toml/light.png light"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.0"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Navigate Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/navigate-dark-color-theme.json"
      },
      {
        "label": "Navigate Light",
        "uiTheme": "vs",
        "path": "./themes/navigate-light-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "navigate.injection.rust",
        "path": "./syntaxes/rust.injection.json",
        "injectTo": ["source.rust", "text.html.markdown"]
      },
      {
        "scopeName": "navigate.injection.python",
        "path": "./syntaxes/python.injection.json",
        "injectTo": ["source.python", "text.html.markdown"]
      },
      {
        "scopeName": "navigate.injection.python-parameters",
        "path": "./syntaxes/python-parameters.injection.json",
        "injectTo": ["source.python", "text.html.markdown"]
      },
      {
        "scopeName": "navigate.injection.python-return",
        "path": "./syntaxes/python-return.injection.json",
        "injectTo": ["source.python", "text.html.markdown"]
      },
      {
        "scopeName": "navigate.injection.sql",
        "path": "./syntaxes/sql.injection.json",
        "injectTo": ["source.sql", "source.sql.jinja", "text.html.markdown"]
      },
      {
        "scopeName": "navigate.injection.jinja",
        "path": "./syntaxes/jinja.injection.json",
        "injectTo": ["source.sql", "source.sql.jinja"]
      }
    ]
  }
}
