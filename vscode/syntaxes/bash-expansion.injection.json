{
  "scopeName": "navigate.injection.bash-expansion",
  "injectionSelector": "L:(source.shell | meta.embedded.block.shellscript) meta.parameter-expansion",
  "patterns": [
    {
      "begin": "(?<=\\$\\{)(!?)([A-Za-z_]\\w*|\\d+|[@*#?$!-])(?:(\\[)([^\\]]*)(\\]))?(?=:?[-=+?]|##?|%%?|/)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.expansion.shell" },
        "2": { "name": "variable.other.normal.shell" },
        "3": { "name": "punctuation.section.array.shell" },
        "4": { "patterns": [{ "include": "source.shell#special_expansion" }, { "include": "source.shell#string" }, { "include": "source.shell#variable" }] },
        "5": { "name": "punctuation.section.array.shell" }
      },
      "end": "(?=\\})",
      "patterns": [{ "include": "#default" }, { "include": "#affix" }, { "include": "#replace" }]
    }
  ],
  "repository": {
    "default": {
      "begin": "\\G:?[-=+?]",
      "beginCaptures": { "0": { "name": "keyword.operator.expansion.shell" } },
      "end": "(?=\\})",
      "contentName": "string.unquoted.expansion.shell",
      "patterns": [{ "include": "#value" }]
    },
    "affix": {
      "begin": "\\G(?:##?|%%?)",
      "beginCaptures": { "0": { "name": "keyword.operator.expansion.shell" } },
      "end": "(?=\\})",
      "contentName": "string.unquoted.expansion.shell",
      "patterns": [{ "include": "#glob" }, { "include": "#value" }]
    },
    "replace": {
      "begin": "\\G/[/#%]?",
      "beginCaptures": { "0": { "name": "keyword.operator.expansion.shell" } },
      "end": "(?=\\})",
      "contentName": "string.unquoted.expansion.shell",
      "patterns": [{ "match": "/", "name": "keyword.operator.expansion.shell" }, { "include": "#glob" }, { "include": "#value" }]
    },
    "glob": { "match": "[*?]", "name": "keyword.operator.glob.shell" },
    "value": {
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.shell" },
        { "include": "source.shell#string" },
        { "include": "source.shell#variable" },
        { "include": "source.shell#interpolation" }
      ]
    }
  }
}
