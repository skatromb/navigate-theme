{
  "name": "Navigate Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "include": "./pustota-contrast-ui.json",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#0a0e14",
    "editor.foreground": "#e0ded8",
    "editorBracketHighlight.foreground1": "#949ca8",
    "editorBracketHighlight.foreground2": "#949ca8",
    "editorBracketHighlight.foreground3": "#949ca8",
    "editorBracketHighlight.foreground4": "#949ca8",
    "editorBracketHighlight.foreground5": "#949ca8",
    "editorBracketHighlight.foreground6": "#949ca8"
  },
  "tokenColors": [
    {
      "name": "Important: control flow, ?, macros, unsafe",
      "scope": [
        "keyword.control",
        "entity.name.function.macro",
        "entity.name.type.macro",
        "keyword.operator.question.rust",
        "keyword.other.unsafe.rust"
      ],
      "settings": {
        "foreground": "#e3825f"
      }
    },
    {
      "name": "Italic: comments",
      "scope": [
        "comment",
        "comment punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cfa463",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.definition.char",
        "constant.character.escape",
        "storage.type.string.python",
        "string.regexp keyword",
        "string.regexp punctuation"
      ],
      "settings": {
        "foreground": "#86c17a"
      }
    },
    {
      "name": "Insignificant: keywords, syntax operators, punctuation",
      "scope": [
        "keyword",
        "storage",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "punctuation",
        "meta.impl.rust keyword.control",
        "variable.language.super",
        "meta.use entity.name.namespace",
        "entity.name.type.lifetime",
        "entity.name.namespace.python",
        "constant.character.format.placeholder.other.python"
      ],
      "settings": {
        "foreground": "#949ca8"
      }
    },
    {
      "name": "Regular: math, comparison, logic operators",
      "scope": [
        "keyword.operator.math",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.exponent",
        "keyword.operator.assignment.compound",
        "keyword.operator.assignment.rust"
      ],
      "settings": {
        "foreground": "#e0ded8"
      }
    },
    {
      "name": "Italic insignificant: doc comments",
      "scope": [
        "comment.line.documentation",
        "comment.block.documentation",
        "comment.line.documentation punctuation.definition.comment",
        "comment.block.documentation punctuation.definition.comment",
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7c8490",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "meta.attribute.rust",
        "meta.attribute.rust punctuation",
        "meta.attribute.rust punctuation.definition.string",
        "meta.attribute.rust string",
        "meta.attribute.rust keyword",
        "meta.function.decorator.python",
        "meta.function.decorator.python punctuation",
        "meta.function.decorator.python punctuation.definition.string",
        "meta.function.decorator.python string",
        "meta.function.decorator.python keyword"
      ],
      "settings": {
        "foreground": "#5a6270"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ]
}
