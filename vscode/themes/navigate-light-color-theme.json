{
  "name": "Navigate Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "include": "./pustota-light-ui.json",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "*.documentation": {
      "foreground": "#88919c",
      "fontStyle": "italic"
    },
    "selfKeyword:rust": "#292720",
    "selfTypeKeyword:rust": "#292720",
    "operator.controlFlow:rust": "#c35a22",
    "keyword.unsafe:rust": "#c35a22"
  },
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#292720",
    "editorBracketHighlight.foreground1": "#747b86",
    "editorBracketHighlight.foreground2": "#747b86",
    "editorBracketHighlight.foreground3": "#747b86",
    "editorBracketHighlight.foreground4": "#747b86",
    "editorBracketHighlight.foreground5": "#747b86",
    "editorBracketHighlight.foreground6": "#747b86"
  },
  "tokenColors": [
    {
      "name": "Important: control flow, ?, macros, unsafe",
      "scope": [
        "keyword.control",
        "entity.name.function.macro",
        "entity.name.type.macro",
        "keyword.operator.question.rust",
        "keyword.other.unsafe.rust"
      ],
      "settings": {
        "foreground": "#c35a22"
      }
    },
    {
      "name": "Bold: declaration names",
      "scope": [
        "source.rust entity.name.type.declaration.rust",
        "meta.embedded.block.rust entity.name.type.declaration.rust",
        "entity.name.module.rust",
        "meta.impl.rust > entity.name.type",
        "entity.name.function.definition.rust",
        "entity.name.type.class.python",
        "entity.name.type.alias.python",
        "meta.function.python entity.name.function.python",
        "meta.create.sql entity.name.function.sql",
        "entity.name.type.cte.sql",
        "entity.name.function.definition.jinja",
        "meta.function.shell entity.name.function.shell",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#292720",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold important: macro declaration names",
      "scope": [
        "meta.macro.rules.rust entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#c35a22",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic: comments",
      "scope": [
        "comment",
        "comment punctuation.definition.comment",
        "meta.funcsign.dbt",
        "meta.funcsign.dbt keyword",
        "meta.funcsign.dbt keyword.control",
        "meta.funcsign.dbt punctuation"
      ],
      "settings": {
        "foreground": "#a37822",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings and Markdown code",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.definition.char",
        "constant.character.escape",
        "storage.type.string.python",
        "string.regexp keyword",
        "string.regexp punctuation",
        "markup.inline.raw.string.markdown",
        "markup.fenced_code.block.markdown",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#3d8f35"
      }
    },
    {
      "name": "Insignificant: keywords, syntax operators, punctuation, Markdown URLs",
      "scope": [
        "keyword",
        "storage",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "punctuation",
        "meta.impl.rust keyword.control",
        "variable.language.super",
        "meta.use variable.language.self",
        "meta.use entity.name.namespace",
        "meta.type.rust",
        "entity.name.type.lifetime",
        "meta.attribute.rust",
        "meta.attribute.rust string",
        "meta.attribute.rust punctuation.definition.string",
        "entity.name.namespace.python",
        "meta.type.python",
        "meta.type.python string",
        "meta.type.python punctuation.definition.string",
        "constant.character.format.placeholder.other.python",
        "meta.function.decorator.python",
        "meta.function.decorator.python string",
        "meta.function.decorator.python punctuation.definition.string",
        "meta.type.sql",
        "meta.type.sql storage.type.sql",
        "keyword.control.flow.block-scalar",
        "entity.other.document",
        "entity.name.tag.yaml punctuation.definition.string",
        "fenced_code.block.language",
        "markup.underline.link",
        "meta.separator.markdown",
        "markup.heading.setext",
        "source.shell constant.other.option",
        "meta.embedded.block.shellscript constant.other.option",
        "constant.character.escape.line-continuation.shell",
        "string.interpolated.process-substitution.shell > punctuation.definition.string",
        "source.shell string punctuation.definition.variable variable",
        "meta.embedded.block.shellscript string punctuation.definition.variable variable"
      ],
      "settings": {
        "foreground": "#747b86"
      }
    },
    {
      "name": "Insignificant: shebang",
      "scope": [
        "meta.shebang.shell",
        "meta.shebang.shell punctuation.definition.comment.shebang.shell"
      ],
      "settings": {
        "foreground": "#747b86",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular: SQL types, Jinja expressions, JSON and YAML keys, YAML numbers and anchors, shell words, code inside strings, Markdown link text and code blocks with a language",
      "scope": [
        "storage.type.sql",
        "markup.fenced_code.block.markdown meta.embedded.block",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown",
        "meta.embedded.inline.jinja",
        "meta.embedded.block.jinja",
        "support.type.property-name.json",
        "support.type.property-name.json constant.character.escape",
        "entity.name.tag.yaml",
        "entity.name.tag.yaml constant.character.escape",
        "string.unquoted.plain constant",
        "variable.other.anchor.yaml",
        "variable.other.alias.yaml",
        "string.unquoted.argument.shell",
        "string.unquoted.shell",
        "string.interpolated.process-substitution.shell",
        "string.interpolated.backtick.shell",
        "string.unquoted.herestring.shell",
        "source.shell string meta.arithmetic.shell",
        "source.shell string variable",
        "source.shell string meta.parameter-expansion",
        "source.shell string meta.scope.subshell",
        "meta.embedded.block.shellscript string meta.arithmetic.shell",
        "meta.embedded.block.shellscript string variable",
        "meta.embedded.block.shellscript string meta.parameter-expansion",
        "meta.embedded.block.shellscript string meta.scope.subshell"
      ],
      "settings": {
        "foreground": "#292720"
      }
    },
    {
      "name": "Italic insignificant: doc comments",
      "scope": [
        "comment.line.documentation",
        "comment.block.documentation",
        "comment.line.documentation punctuation.definition.comment",
        "comment.block.documentation punctuation.definition.comment",
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#88919c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ]
}
